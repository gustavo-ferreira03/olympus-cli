{
  "name": "olympus-cli-gustavos-fork",
  "version": "0.2.0-gustavo.1",
  "description": "Olympus CLI \u2014 Gustavo's Fork, maintained in TypeScript with current check APIs",
  "type": "module",
  "homepage": "https://shipd.ai/quests/olympus",
  "keywords": [
    "shipd",
    "olympus",
    "cli",
    "convex"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.1",
  "bin": {
    "olympus": "dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/index.js',0o755)\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "lint:ci": "oxlint --max-warnings=113",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "dupes": "jscpd src",
    "deadcode": "knip",
    "deadcode:all": "knip --include files,dependencies,unlisted,binaries,exports,types",
    "verify": "pnpm format:check && pnpm lint:ci && pnpm typecheck && pnpm dupes && pnpm deadcode",
    "cli": "node dist/index.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "acorn": "^8.18.0",
    "citty": "^0.2.1",
    "convex": "^1.29.0",
    "log-update": "^7.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jscpd": "^5.2.0",
    "knip": "^6.35.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsx": "^4.21.0",
    "typescript": "~5.7.0"
  },
  "private": true
}
